---
import MoonMark from './MoonMark.astro';
import ThemeToggle from './ThemeToggle.astro';
import { sitePath } from '../lib/urls';
import { SITE } from '../site';

const currentPath = Astro.url.pathname;
const links = [
  { href: sitePath(''), label: '文章' },
  { href: sitePath('archive/'), label: '归档' },
  { href: sitePath('tags/'), label: '标签' },
  { href: sitePath('about/'), label: '关于' },
];

function isActive(href: string) {
  if (href === sitePath('')) return currentPath === href;
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="brand" href={sitePath('')} aria-label={`${SITE.title}首页`}>
      <MoonMark compact />
      <span>
        <strong>{SITE.title}</strong>
        <small>LETTERS FROM THE FAR SIDE</small>
      </span>
    </a>

    <nav aria-label="主要导航">
      {
        links.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    border-bottom: 1px solid var(--line);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: clamp(1rem, 4vw, 2.8rem);
    align-items: center;
    min-height: 5.25rem;
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.7rem;
    color: var(--text);
    text-decoration: none;
  }

  .brand span {
    display: grid;
    gap: 0.12rem;
  }

  .brand strong {
    font: 500 1rem/1.2 var(--font-display);
    letter-spacing: 0.08em;
  }

  .brand small {
    color: var(--text-faint);
    font: 500 0.58rem/1.2 var(--font-utility);
    letter-spacing: 0.13em;
  }

  nav {
    display: flex;
    gap: clamp(0.9rem, 2.5vw, 1.8rem);
  }

  nav a {
    position: relative;
    color: var(--text-soft);
    text-decoration: none;
    font: 500 0.82rem/1 var(--font-utility);
  }

  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -0.55rem;
    height: 2px;
    background: var(--accent);
    transition: right 180ms ease;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }

  nav a:hover::after,
  nav a[aria-current='page']::after {
    right: 0;
  }

  @media (max-width: 680px) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      min-height: 4.6rem;
    }

    nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: space-between;
      padding-bottom: 1rem;
    }

    .brand small {
      display: none;
    }
  }
</style>
