---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class:list={['moon-mark', { compact }]} aria-hidden="true">
  <span class="moon-mark__orbit"></span>
  <span class="moon-mark__disc"></span>
</span>

<style>
  .moon-mark {
    display: inline-grid;
    width: 3rem;
    aspect-ratio: 1;
    place-items: center;
    position: relative;
    flex: none;
  }

  .moon-mark__disc {
    width: 1.35rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--moon-disc);
    box-shadow: inset -0.35rem 0 0 var(--moon-shadow);
  }

  .moon-mark__orbit {
    position: absolute;
    inset: 0.22rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transform: rotate(-24deg) scaleY(0.42);
  }

  .moon-mark__orbit::after {
    content: '';
    position: absolute;
    width: 0.32rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
    right: 0.18rem;
    top: 0.1rem;
  }

  .compact {
    width: 2.35rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .moon-mark__orbit {
      animation: settle 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: rotate(-52deg) scaleY(0.2);
    }
  }
</style>
