---
import type { Post } from '../lib/posts';
import { getPostPath, getReadingTime } from '../lib/posts';
import { sitePath } from '../lib/urls';
import FormattedDate from './FormattedDate.astro';

interface Props {
  posts: Post[];
  showYear?: boolean;
}

const { posts, showYear = false } = Astro.props;
---

<div class="post-list">
  {
    posts.map((post, index) => (
      <article class="post-row">
        <div class="post-row__index" aria-hidden="true">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <i></i>
        </div>
        <div class="post-row__body">
          <div class="post-row__meta">
            <FormattedDate date={post.data.published} compact={!showYear} />
            <span>{getReadingTime(post.body)}</span>
          </div>
          <h2><a href={sitePath(getPostPath(post))}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
          <ul aria-label="文章标签">
            {post.data.tags.map((tag) => <li><a href={sitePath(`tags/${encodeURIComponent(tag)}/`)}>#{tag}</a></li>)}
          </ul>
        </div>
      </article>
    ))
  }
</div>

<style>
  .post-list {
    border-top: 1px solid var(--line);
  }

  .post-row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    padding: clamp(2rem, 4vw, 3.4rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .post-row__index {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: var(--text-faint);
    font: 500 0.64rem/1 var(--font-utility);
    letter-spacing: 0.08em;
    padding-top: 0.38rem;
  }

  .post-row__index i {
    flex: 1;
    height: 1px;
    margin-top: 0.25rem;
    background: var(--line-strong);
    transform-origin: left;
    transition: transform 220ms ease, background 220ms ease;
  }

  .post-row:hover .post-row__index i {
    background: var(--accent);
    transform: scaleX(1.2);
  }

  .post-row__meta {
    display: flex;
    gap: 1.2rem;
    align-items: center;
    color: var(--text-faint);
    font: 500 0.68rem/1.4 var(--font-utility);
    letter-spacing: 0.05em;
  }

  .post-row__meta span::before {
    content: '·';
    margin-right: 1.2rem;
  }

  h2 {
    max-width: 48rem;
    margin: 0.65rem 0 0.75rem;
    font: 500 clamp(1.55rem, 3vw, 2.35rem)/1.3 var(--font-display);
    letter-spacing: -0.025em;
  }

  h2 a {
    color: var(--text);
    text-decoration: none;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.14em;
  }

  h2 a:hover {
    text-decoration-line: underline;
    text-decoration-color: var(--accent);
  }

  .post-row__body > p {
    max-width: 43rem;
    margin: 0;
    color: var(--text-soft);
    line-height: 1.85;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin: 1.2rem 0 0;
    padding: 0;
    list-style: none;
  }

  li a {
    color: var(--text-faint);
    text-decoration: none;
    font: 500 0.68rem/1.4 var(--font-utility);
  }

  li a:hover {
    color: var(--accent);
  }

  @media (max-width: 680px) {
    .post-row {
      grid-template-columns: 2.3rem minmax(0, 1fr);
      gap: 1rem;
    }

    .post-row__index i {
      display: none;
    }

    h2 {
      font-size: 1.45rem;
    }
  }
</style>
