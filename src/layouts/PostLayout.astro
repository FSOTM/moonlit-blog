---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getReadingTime } from '../lib/posts';
import { sitePath } from '../lib/urls';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  published: Date;
  updated?: Date;
  tags: string[];
  body?: string;
  headings?: Heading[];
}

const { title, description, published, updated, tags, body = '', headings = [] } = Astro.props;
const sectionHeadings = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={title} description={description} type="article">
  <article class="article shell">
    <header class="article__header">
      <p class="eyebrow">FIELD NOTE / {published.getFullYear()}</p>
      <h1>{title}</h1>
      <p class="article__lead">{description}</p>
      <div class="article__meta">
        <FormattedDate date={published} />
        <span>{getReadingTime(body)}阅读</span>
        {updated && <span>更新于 <FormattedDate date={updated} compact /></span>}
      </div>
    </header>

    <div class="article__line" aria-hidden="true"><i></i><span></span></div>

    <div class="article__grid">
      <aside class="article__aside">
        {
          sectionHeadings.length > 0 && (
            <nav aria-label="文章目录">
              <strong>本页内容</strong>
              {sectionHeadings.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
            </nav>
          )
        }
        <ul aria-label="文章标签">
          {tags.map((tag) => <li><a href={sitePath(`tags/${encodeURIComponent(tag)}/`)}>#{tag}</a></li>)}
        </ul>
      </aside>

      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding-top: clamp(4rem, 9vw, 8rem);
  }

  .article__header {
    max-width: 58rem;
  }

  .eyebrow {
    margin: 0 0 1.8rem;
    color: var(--accent);
    font: 500 0.68rem/1.4 var(--font-utility);
    letter-spacing: 0.13em;
  }

  h1 {
    max-width: 54rem;
    margin: 0;
    font: 500 clamp(2.8rem, 7vw, 6rem)/1.08 var(--font-display);
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .article__lead {
    max-width: 44rem;
    margin: 2rem 0;
    color: var(--text-soft);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.85;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    color: var(--text-faint);
    font: 500 0.7rem/1.5 var(--font-utility);
  }

  .article__meta > span::before {
    content: '·';
    margin-right: 1.6rem;
  }

  .article__line {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    margin: clamp(3rem, 7vw, 5.5rem) 0;
  }

  .article__line i {
    height: 1px;
    background: var(--line);
  }

  .article__line span {
    display: block;
    width: 0.72rem;
    aspect-ratio: 1;
    border: 1px solid var(--accent);
    border-radius: 50%;
  }

  .article__grid {
    display: grid;
    grid-template-columns: minmax(9rem, 13rem) minmax(0, 43rem);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
    justify-content: center;
  }

  .article__aside {
    position: sticky;
    top: 2rem;
    display: grid;
    gap: 2.5rem;
    color: var(--text-faint);
    font: 500 0.68rem/1.5 var(--font-utility);
  }

  .article__aside nav {
    display: grid;
    gap: 0.75rem;
  }

  .article__aside strong {
    margin-bottom: 0.3rem;
    color: var(--text-soft);
    font-weight: 500;
  }

  .article__aside a {
    color: inherit;
    text-decoration: none;
  }

  .article__aside a:hover {
    color: var(--accent);
  }

  .article__aside ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 760px) {
    .article__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .article__aside {
      position: static;
    }

    .article__aside nav {
      display: none;
    }
  }
</style>
