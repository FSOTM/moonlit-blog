---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPublishedPosts } from '../lib/posts';
import { sitePath } from '../lib/urls';
import { SITE } from '../site';

const posts = await getPublishedPosts();
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="eyebrow">PERSONAL FIELD NOTES · {SITE.author}</p>
      <h1>把复杂问题，<br /><em>写到可以验证。</em></h1>
      <p>{SITE.description}</p>
    </div>

    <div class="lunar-window" aria-hidden="true">
      <div class="lunar-window__coordinate">23.5° / FAR SIDE</div>
      <div class="lunar-window__orbit"><i></i></div>
      <div class="lunar-window__moon"></div>
      <div class="lunar-window__signal"></div>
      <span>REC · {String(posts.length).padStart(2, '0')}</span>
    </div>
  </section>

  <section class="latest shell" aria-labelledby="latest-title">
    <header class="section-heading">
      <div>
        <p>RECENT TRANSMISSIONS</p>
        <h2 id="latest-title">最近文章</h2>
      </div>
      <a href={sitePath('archive/')}>查看全部归档 <span aria-hidden="true">↗</span></a>
    </header>
    <PostList posts={posts.slice(0, 6)} />
  </section>

  <section class="manifesto shell">
    <p>写作原则</p>
    <blockquote>经验形成判断，事实校正判断。每一篇文章都尽量留下可复现的路径。</blockquote>
    <a href={sitePath('about/')}>关于本站</a>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
    min-height: min(46rem, calc(100svh - 5.3rem));
    padding-block: clamp(4.5rem, 10vw, 8.5rem);
  }

  .eyebrow,
  .section-heading p,
  .manifesto > p {
    margin: 0;
    color: var(--accent);
    font: 500 0.66rem/1.4 var(--font-utility);
    letter-spacing: 0.14em;
  }

  .hero h1 {
    max-width: 55rem;
    margin: 1.7rem 0 2rem;
    font: 500 clamp(3.6rem, 8.5vw, 7.7rem)/1.03 var(--font-display);
    letter-spacing: -0.06em;
    text-wrap: balance;
  }

  .hero h1 em {
    color: var(--text-soft);
    font-style: normal;
  }

  .hero__copy > p:last-child {
    max-width: 38rem;
    margin: 0;
    color: var(--text-soft);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.9;
  }

  .lunar-window {
    position: relative;
    width: min(100%, 23rem);
    aspect-ratio: 0.82;
    justify-self: end;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 50% 50% 0.8rem 0.8rem;
    background:
      radial-gradient(circle at 48% 38%, var(--moon-glow), transparent 32%),
      linear-gradient(180deg, var(--night-upper), var(--night-lower));
    color: var(--night-text);
  }

  .lunar-window::after {
    content: '';
    position: absolute;
    inset: auto -20% -20% -20%;
    height: 46%;
    border-radius: 50% 50% 0 0;
    background: var(--lunar-ground);
    box-shadow: inset 0 1px 0 var(--lunar-rim);
  }

  .lunar-window__coordinate,
  .lunar-window > span {
    position: absolute;
    z-index: 4;
    left: 1.4rem;
    top: 1.55rem;
    font: 500 0.58rem/1 var(--font-utility);
    letter-spacing: 0.12em;
  }

  .lunar-window > span {
    top: auto;
    bottom: 1.25rem;
  }

  .lunar-window__moon {
    position: absolute;
    z-index: 2;
    width: 45%;
    aspect-ratio: 1;
    right: 13%;
    top: 22%;
    border-radius: 50%;
    background: var(--moon-disc);
    box-shadow:
      inset -2rem -0.2rem 0 var(--moon-shadow),
      0 0 3rem var(--moon-glow);
  }

  .lunar-window__orbit {
    position: absolute;
    z-index: 3;
    width: 72%;
    aspect-ratio: 1;
    right: -2%;
    top: 9%;
    border: 1px solid var(--orbit-line);
    border-radius: 50%;
    transform: rotate(-21deg) scaleY(0.42);
  }

  .lunar-window__orbit i {
    position: absolute;
    width: 0.5rem;
    aspect-ratio: 1;
    right: 7%;
    top: 18%;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 1rem var(--signal);
  }

  .lunar-window__signal {
    position: absolute;
    z-index: 4;
    left: 20%;
    bottom: 25%;
    width: 0.35rem;
    height: 2.2rem;
    background: var(--accent);
    transform: rotate(-18deg);
    box-shadow: 0 0 1.2rem var(--accent);
  }

  .latest {
    padding-top: clamp(4rem, 9vw, 8rem);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .section-heading h2 {
    margin: 0.5rem 0 0;
    font: 500 clamp(2.2rem, 5vw, 4rem)/1.1 var(--font-display);
    letter-spacing: -0.04em;
  }

  .section-heading a,
  .manifesto a {
    color: var(--text-soft);
    text-decoration: none;
    font: 500 0.72rem/1.4 var(--font-utility);
  }

  .section-heading a:hover,
  .manifesto a:hover {
    color: var(--accent);
  }

  .manifesto {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) auto;
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: start;
    margin-top: clamp(5rem, 11vw, 10rem);
    padding-block: 2.5rem;
    border-block: 1px solid var(--line);
  }

  .manifesto blockquote {
    max-width: 48rem;
    margin: 0;
    font: 500 clamp(1.5rem, 3vw, 2.4rem)/1.55 var(--font-display);
    letter-spacing: -0.025em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lunar-window__moon {
      animation: moon-arrive 1000ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }

  @keyframes moon-arrive {
    from {
      opacity: 0;
      transform: translate(2rem, -1rem) scale(0.88);
    }
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .lunar-window {
      width: min(72vw, 23rem);
      justify-self: start;
    }
  }

  @media (max-width: 680px) {
    .hero h1 {
      font-size: clamp(3rem, 15vw, 4.8rem);
    }

    .section-heading {
      align-items: start;
      flex-direction: column;
    }

    .manifesto {
      grid-template-columns: 1fr;
    }
  }
</style>
